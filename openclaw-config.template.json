{
  "gateway": {
    "port": 18789,
    "model": "google/gemini-3-flash-preview"
  },
  "providers": {
    "google": {
      "apiKey": "${GEMINI_API_KEY}"
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "botToken": "${DISCORD_BOT_TOKEN}"
    },
    "telegram": {
      "enabled": false,
      "botToken": "${TELEGRAM_BOT_TOKEN}"
    },
    "slack": {
      "enabled": false,
      "credential": "${SLACK_CREDENTIAL}"
    }
  },
  "skills": [
    {
      "path": "./manageme.skill.md",
      "name": "manageme",
      "env": {
        "MANAGEME_API_URL": "http://localhost:3000",
        "MANAGEME_OPENCLAW_SECRET": "REPLACE_WITH_WORKSPACE_SECRET",
        "MANAGEME_WORKSPACE_ID": "REPLACE_WITH_WORKSPACE_ID"
      }
    }
  ],
  "cron": [
    {
      "schedule": "0 8 * * *",
      "message": "Use the manageme skill to send a morning briefing of open, high-priority, and due-today tasks."
    },
    {
      "schedule": "0 * * * *",
      "message": "Use the manageme skill to check for tasks due within 1 hour and send concise reminders."
    },
    {
      "schedule": "0 18 * * *",
      "message": "Use the manageme skill to summarize completed tasks and remaining work."
    }
  ]
}
