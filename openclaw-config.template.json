{
  "agents": {
    "defaults": {
      "workspace": "/home/your-user/.openclaw/workspace",
      "model": {
        "primary": "google/gemini-3.1-flash-lite"
      },
      "skills": ["manageme"],
      "models": {
        "google/gemini-3.1-pro-preview": {},
        "google/gemini-3-flash-preview": {}
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_RANDOM_TOKEN"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding"
  },
  "auth": {
    "profiles": {
      "google:default": {
        "provider": "google",
        "mode": "api_key"
      }
    }
  },
  "channels": {
    "discord": {
      "enabled": true,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "DISCORD_BOT_TOKEN"
      }
    }
  },
  "skills": {
    "entries": {
      "manageme": {
        "env": {
          "MANAGEME_API_URL": "http://YOUR_HOST:3000",
          "MANAGEME_WORKSPACE_ID": "YOUR_WORKSPACE_ID"
        }
      }
    }
  }
}